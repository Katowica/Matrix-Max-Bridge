# Matrix–Max Bridge — пример конфигурации.
# Скопируйте этот файл в `.env` и заполните реальными значениями.
# НИКОГДА не коммитьте реальные секреты в систему контроля версий. В production.

# --- Бот Max ---
# Токен из Max Bot API (https://dev.max.ru/docs-api). При утечке немедленно отзовите.
MAX_BOT_TOKEN=

# --- Бот Matrix ---
# Базовый URL homeserver. Обязательно должен начинаться с https://, чтобы токен
# доступа не передавался по открытому каналу.
MATRIX_HS_URL=https://matrix.example.org
# Полный MXID учётной записи бота, например @max.bot:example.org
MATRIX_USER_ID=@max.bot:example.org
# Долгоживущий токен доступа учётной записи бота. При утечке немедленно отзовите.
MATRIX_ACCESS_TOKEN=

# --- Хранилище ---
# Путь к файлу базы данных SQLite. По умолчанию в Docker: /data/bridge.db
DATABASE_PATH=/data/bridge.db

# Время жизни одноразового кода привязки, в секундах.
LINK_CODE_TTL_SECONDS=3600

# Необязательно: разрешить привязку только к комнатам Matrix на этом имени сервера
# (или его поддомене). Оставьте пустым / закомментированным, чтобы разрешить любой сервер.
# MATRIX_ALLOWED_SERVER=matrix.example.org

# --- Ограничение частоты (rate limiting) ---
RATE_LIMIT_LINK_ATTEMPTS=20
RATE_LIMIT_LINK_WINDOW_SECONDS=300
RATE_LIMIT_CODE_GENERATIONS=10
RATE_LIMIT_CODE_WINDOW_SECONDS=3600

# --- Среда выполнения (необязательно) ---
# Максимальный размер одного скачивания/загрузки медиа (в обоих направлениях). По умолчанию 20 МиБ.
# MAX_DOWNLOAD_BYTES=20971520
